# Configuración servidor
PORT=8083
ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=rescateam-chatdb

# JWT
JWT_SECRET=supersecret

# VAPID (reemplazá con tus claves reales generadas con webpush)
VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=yyyyyyyyyyyyyyyyyyyyyyyy

